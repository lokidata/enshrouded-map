# Copy to deploy/.env (never commit it).

# Published port of the web container: bind it to the LAN address your reverse proxy reaches.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Address of your reverse proxy as seen by the container: the client IP is only trusted from there.
REVERSE_PROXY_IP=127.0.0.1
# Generated map data (tiles, icons, map-data.json, resources.json, biomes.png)
ARTIFACTS_DIR=../artifacts/map

# API (read by the api container)
COOKIE_SECURE=true          # set to false only for plain-http tests
INVITATION_MINUTES=20
# LOGIN_RATE_LIMIT=10/5 minutes
# Code asked for the very first account. Left empty, a random one is printed in the api log (docker compose logs api).
# SETUP_TOKEN=
