{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "alegreya-sans-latin-{400,500,700}-*.woff2",
                "input": "node_modules/@fontsource/alegreya-sans/files",
                "output": "/fonts"
              },
              {
                "glob": "*-latin-*-*.woff2",
                "input": "node_modules/@fontsource/im-fell-english/files",
                "output": "/fonts"
              },
              {
                "glob": "*-latin-*-*.woff2",
                "input": "node_modules/@fontsource/im-fell-english-sc/files",
                "output": "/fonts"
              }
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.css",
              "src/app/workshop/workshop.css"
            ],
            "allowedCommonJsDependencies": ["leaflet"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "**/*",
                  "input": "map-artifacts",
                  "output": "/"
                },
                {
                  "glob": "alegreya-sans-latin-{400,500,700}-*.woff2",
                  "input": "node_modules/@fontsource/alegreya-sans/files",
                  "output": "/fonts"
                },
                {
                  "glob": "*-latin-*-*.woff2",
                  "input": "node_modules/@fontsource/im-fell-english/files",
                  "output": "/fonts"
                },
                {
                  "glob": "*-latin-*-*.woff2",
                  "input": "node_modules/@fontsource/im-fell-english-sc/files",
                  "output": "/fonts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
