# Rendered by the image entrypoint (envsubst): only ${REVERSE_PROXY_IP} is substituted.
# HSTS and TLS are left to the reverse proxy in front of this container.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    # The client address is read from X-Forwarded-For only when it comes from the reverse proxy.
    set_real_ip_from ${REVERSE_PROXY_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    client_max_body_size 4m;
    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwritten, not appended: the API only ever sees the address nginx resolved.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 30s;
    }

    # Asked before every map file: the API answers 204 for a logged-in session, 401 otherwise.
    # shortcut: one API call per file (a map view loads dozens), no cache; add proxy_cache if it ever hurts.
    location = /_auth {
        internal;
        proxy_pass http://api:8000/api/v1/auth/check;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Map data generated by the pipeline, mounted read-only: for logged-in players only.
    location ^~ /tiles/ {
        auth_request /_auth;
        root /srv/artifacts;
        expires 1d;
    }
    location ^~ /icons/ {
        auth_request /_auth;
        root /srv/artifacts;
        expires 1d;
    }
    # item pictures shown in the popups
    location ^~ /items/ {
        auth_request /_auth;
        root /srv/artifacts;
        expires 1d;
    }
    location = /biomes.png {
        auth_request /_auth;
        root /srv/artifacts;
        expires 1d;
    }
    location = /overview.jpg {
        auth_request /_auth;
        root /srv/artifacts;
        expires 1d;
    }
    # Revalidated on each load (ETag): a new pipeline run shows up right away.
    location ~ ^/(map-data|resources)\.json$ {
        auth_request /_auth;
        root /srv/artifacts;
        expires -1;
    }

    location ~ /\. {
        return 404;
    }

    # Hashed build files can be cached for good.
    location ~* \.(js|css)$ {
        root /usr/share/nginx/html;
        expires 1y;
    }
    location / {
        root /usr/share/nginx/html;
        expires -1;
        try_files $uri /index.html;
    }
}
